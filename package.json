{
  "name": "agent-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "Modular autonomous incident-response agent",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:monitoring": "pnpm --filter @agent-guardian/mcp-monitoring dev",
    "dev:logs": "pnpm --filter @agent-guardian/mcp-logs dev",
    "dev:github": "pnpm --filter @agent-guardian/mcp-github dev",
    "dev:database": "pnpm --filter @agent-guardian/mcp-database dev",
    "dev:deployment": "pnpm --filter @agent-guardian/mcp-deployment dev",
    "dev:all-mcp": "pnpm -r --parallel --filter \"./packages/mcp/*\" dev",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
